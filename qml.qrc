        <file alias="Theme.qml">qml/Theme.qml</file>
        <file alias="IconGlyph.qml">qml/components/IconGlyph.qml</file>
        <file alias="NavItem.qml">qml/components/NavItem.qml</file>
        <file alias="Sidebar.qml">qml/components/Sidebar.qml</file>
        <file alias="SerialBar.qml">qml/components/SerialBar.qml</file>
        <file alias="TopBar.qml">qml/components/TopBar.qml</file>
        <file alias="StatusDot.qml">qml/components/StatusDot.qml</file>
        <file alias="NodeCard.qml">qml/components/NodeCard.qml</file>
        <file alias="Sparkline.qml">qml/components/Sparkline.qml</file>
        <file alias="DetailPanel.qml">qml/components/DetailPanel.qml</file>
        <file alias="TelemetryChart.qml">qml/components/TelemetryChart.qml</file>
        <file alias="SegmentedControl.qml">qml/components/SegmentedControl.qml</file>
        <file alias="IndustrialButton.qml">qml/components/IndustrialButton.qml</file>
        <file alias="DashboardPage.qml">qml/pages/DashboardPage.qml</file>
        <file alias="AlertLogPage.qml">qml/pages/AlertLogPage.qml</file>
        <file alias="MapPage.qml">qml/pages/MapPage.qml</file>
        <file alias="SettingsPage.qml">qml/pages/SettingsPage.qml</file>
    </qresource>
    <qresource prefix="/">
        <file>qtquickcontrols2.conf</file>
    </qresource>
</RCC>
